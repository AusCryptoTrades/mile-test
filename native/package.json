{
  "name": "mile-native",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "test": "node --test scripts/stage.test.mjs",
    "prepare:ios": "npm run stage && cap add ios && cap sync ios",
    "prepare:android": "npm run stage && cap add android && cap sync android",
    "sync": "npm run stage && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "8.0.0",
    "@capacitor/ios": "8.0.0",
    "@capacitor/android": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0"
  }
}
